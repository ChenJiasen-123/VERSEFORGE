    {
      "poem": {
        "title": "涸辙问",
        "lines": [
          "辙中枯鲋要微澜",
          "却道西江远可寒",
          "斗水目前能活否",
          "何劳大泽问漫漫"
        ]
      },
      "allusion_claim": {
        "card_id": "he-zhe",
        "mode": "明用",
        "relation": "取《庄子·外物》鲋鱼索斗升之水、对方却许诺远引西江之水的原义，将焦点放在眼前小助与将来大诺的错位；末句反问回应原典，强调及时的小水比遥远的大水更切近生死。"
      },
