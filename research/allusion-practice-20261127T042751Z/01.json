  "initial_review": {
    "decision": "revise",
    "quote": "斗水能活涸辙鲋",
    "problem": "“斗水能活涸辙鲋”与典源关系错位。典源中鲋鱼请求的是“斗升之水”以活命，而庄周实际能给予的是“激西江之水”的宏大许诺；关键在急需的小水与远水大诺之间的错位。此处“斗水能活”直接说出了水的救急功用，却并未让官职许诺的“来岁开仓放万斛”与眼前斗水形成被质疑的关系，反而像一个未展开的格言判断。第三句与第四句“何须沧海待春足”意思承接，都在说小水即可、不必等待大水，与前两句“官诺来岁”的对比存在，但“沧海”“春足”是正文新增的意象，且“春足”搭配生硬，语义不易落实到“来年开仓”的许诺上，造成断裂。",
    "allusion_anchor": "涸辙鲋",
    "compressed_background": "鲋鱼困于涸辙，只需斗升之水即可活命；庄周却只能许诺将来引西江之水来救。典故压缩的是“眼前急需少量救济”与“遥远宏大许诺”的错位。",
    "suggestion": "把“斗水能活涸辙鲋”改为直接呈现鲋鱼所求与所获许诺之间的错位，例如让“斗升之水”对应“西江之水”或“来岁”的许诺，而不是只说斗水能活；末句“春足”可换成与“来岁开仓”直接相关的时间或动作，避免与“沧海”并列后语义悬空。",
    "keep_reason": ""
  },
  "revision": {
    "title": "闻赈",
    "lines": [
      "说漕来岁发千艘",
      "釜底生机尚未抛",
      "涸辙所须升斗水",
      "不劳激浪接江郊"
    ],
    "pattern": "ping_rhyme",
    "compression_plan": {
      "experience": "饥者听见官府许诺来年大赈，而眼前升斗之需仍悬，救急比宏愿更要紧。",
      "allusion_carries": "涸辙之鲋只求斗升之水以活命，得到的却是远引西江之水的宏大许诺；典故已承担‘眼前小需’与‘遥远大诺’的错位。",
      "present_detail": "正文另写‘来岁发千艘’的官诺与‘釜底生机尚未抛’的眼前一线之望；末以不劳远水收住，不再复述鲋鱼故事。"
    }
  },
