{
  "source_card": {
    "id": "he-zhe",
    "name": "涸辙之鲋",
    "source": "https://zh.wikisource.org/wiki/莊子/外物",
    "source_revision": "11117714",
    "locator": "庄周贷粟、鲋鱼索斗升之水一段",
    "source_summary": "眼前急需少量救济，却得到将来调来大水的许诺。",
    "expression_relation": "当下的小需要与遥远的大承诺错位；帮助是否及时比许诺是否宏大更重要。",
    "misuse": "不是见到干旱、鱼或贫困便能套用；不要把救急原义倒写成歌颂宏愿。",
    "possible_transfer": "最后一位顾客急需一口热食，抽象善意不如当下的一餐；只在作品确有救急关系时适用。"
  },
  "exercise": "饥者听见官府许诺来年大赈；写大许诺不能抵眼前小需要的体验。不可重用此前作品的开头或结尾。",
  "initial": {
    "title": "闻赈",
    "lines": [
      "饥肠已断闻官诺",
      "来岁开仓放万斛",
      "斗水能活涸辙鲋",
      "何须沧海待春足"
    ],
    "pattern": "ze_rhyme",
    "compression_plan": {
      "experience": "饥饿者当下已撑不到官府许诺的来年大赈，远水不救近火",
      "allusion_carries": "涸辙之鲋只剩一口水就能活命，典源已承担“急需少量及时救济”的背景，不再复述鱼与车辙的故事",
      "present_detail": "正文只写眼前饥肠已断、官府空许来岁万斛，以及斗水与沧海的时间差，突出当下所需与遥远承诺的错位"
    }
  },
