{
  "source_card": {
    "id": "ye-wei",
    "name": "曳尾涂中",
    "source": "https://zh.wikisource.org/wiki/莊子/秋水",
    "source_revision": "11117703",
    "locator": "庄子钓于濮水、楚使聘请一段",
    "source_summary": "在死后留骨受尊贵与活着在泥中行走之间，庄子选择后者。",
    "expression_relation": "被供奉的尊贵与可以自主的生活之间的价值选择。",
    "misuse": "不是一切泥泞都象征自由；不能仅把归隐写成风景闲适。",
    "possible_transfer": "不上列车可以是主动不赴某种荣誉或安排；须由题目和正文建立这种选择，不强添传记。"
  },
  "exercise": "辞去一份体面的差事后，亲友都替他惋惜。写他选择自主生活也承受实际代价，不写成悠闲山水。",
  "initial": {
    "title": "辞差自述",
    "lines": [
      "故人劝我惜冠缨，",
      "我择泥途曳尾行。",
      "米价渐高灯渐暗，",
      "夜来犹自听江声。"
    ],
    "pattern": "ping_rhyme",
    "compression_plan": {
      "experience": "辞去体面差事后，主动选择能自主行走的生活，同时承受收入减少、生活变紧的实际代价。",
      "allusion_carries": "用过“曳尾涂中”的语意关系，已经承担被供奉的尊贵与自主生活之间的价值取舍，所以不交代庄子、濮水、楚使，也不复述故事。",
      "present_detail": "正文另承担亲友惋惜的具体压力（首句）和辞职后的现实代价：米价、灯光、夜听江声的独处，不把归隐写成山水闲适。"
    }
  },
