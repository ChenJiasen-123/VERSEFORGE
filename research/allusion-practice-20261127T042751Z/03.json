  "initial_review": {
    "decision": "revise",
    "quote": "久客改音成客声，",
    "problem": "首句“改音成客声”与次句“欲唤旧时名”已把“主动改过乡音、回乡想换回旧称却失败”的完整经历交代清楚，第三句“唇边先熟他乡调”又把同一层意思重说一遍；“先熟”作谓语也生硬——熟的是调子而非唇边，动作落在哪里不明确；它与“欲唤”之间的先后、转折关系没有落实，像是把“改掉又回不去”的意思分成几句并排摆出，推进感弱。",
    "allusion_anchor": "",
    "compressed_background": "",
    "suggestion": "可删去或改写第三句，让“欲唤旧名”的动作直接碰到“他乡调”的阻隔，例如让称呼出口的瞬间显出偏差，而不是再补一句说明“已熟他乡调”；同时把“唇边先熟”换成动作或声音本身的呈现。",
    "keep_reason": ""
  },
  "revision": {
    "title": "乡音改",
    "lines": [
      "客久将归改客声，",
      "临门欲唤旧时名。",
      "未呼阿母音先转，",
      "却问客从何处生。"
    ],
    "pattern": "ping_rhyme",
    "compression_plan": {
      "experience": "久居外地刻意改了乡音，返乡想用旧称呼叫母亲，出口却先成客地口音。",
      "allusion_carries": "寿陵余子学步不成又失故步，为全诗垫下\"主动改换而退不回原路\"的分量，故正文不再复述学步事。",
      "present_detail": "第一句写改音之刻意与归期将至，第二句写临门欲唤旧名的一刻，第三句落实未呼先转的错位，第四句借母亲误认作客问出眼前独有的一刻。"
    }
  },
