{
  "source_card": {
    "id": "han-dan",
    "name": "邯郸学步",
    "source": "https://zh.wikisource.org/wiki/莊子/秋水",
    "source_revision": "11117703",
    "locator": "公孙龙问魏牟段末寿陵余子故事",
    "source_summary": "外来者学习他处步法，未学成又失去原本走法。",
    "expression_relation": "追求另一种方式而失去自身原有能力的代价。",
    "misuse": "不可把一切学习不成都归此典；听熟悉方言却说不出，不自动等于曾主动舍弃自己的语言。",
    "possible_transfer": "方言题可用来反思改口后的自我距离，但原题没有学习经历时不能凭典故硬造事实。"
  },
  "exercise": "一个人久在外地，刻意改过乡音；返乡时，想用从前的叫法唤母亲，却先说出练熟的客语。写主动改变后难以退回自身的体验，不下文化批评结论。",
  "initial": {
    "title": "乡音改",
    "lines": [
      "久客改音成客声，",
      "归门欲唤旧时名。",
      "唇边先熟他乡调，",
      "阿母笑询何处生。"
    ],
    "pattern": "ping_rhyme",
    "compression_plan": {
      "experience": "久居外地刻意改乡音，返乡欲以旧称唤母，却先说出练熟的客语。",
      "allusion_carries": "学习他处方式而失去自身原有能力的代价，暗示主动改变后的自我疏离。",
      "present_detail": "舌端盘旋的客调、母亲闻声后的笑问，呈现当下错愕与无奈。"
    }
  },
