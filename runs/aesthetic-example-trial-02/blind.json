    "samples": [
      {
        "sample_id": "0e6c78bf674e",
        "poem": {
          "title": "第一次在菜市场讲价",
          "lines": [
            "电子秤上跳动的红色数字，",
            "母亲的手按在秤盘边缘。",
            "轮到我站到摊前，把“多少钱”说成一句问路，",
            "卖菜的老人抬头看了我一眼。",
            "他说，你还年轻。",
            "我手里攥着两张皱了的零钱，",
            "等他报出一个我接不住又必须接的价。",
            "旁边称好的半袋土豆，",
            "比昨天多出一两，我没有说话，",
            "只是把钱递过去，找回的铁皮响。"
          ]
        }
      },
      {
        "sample_id": "46c05953c2e7",
        "poem": {
          "title": "第一次在菜市场讲价",
          "lines": [
            "她把“少五毛”说成一句试探，",
            "像往秤盘上多放了一颗小石子。",
            "卖菜人没抬头，只把芹菜",
            "翻了个身，水珠滚过塑料布，",
            "其中一滴停在我鞋尖。",
            "我忽然听见自己说“那就算了”，",
            "声音比来时轻，",
            "却比那把芹菜更沉地拎在手里。",
            "走出三米，她才笑出声——",
            "原来五毛钱一直攥在我汗里。"
          ]
        }
      }
    ]
  }
]
