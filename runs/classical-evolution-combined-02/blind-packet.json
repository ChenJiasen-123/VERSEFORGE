[
  {
    "id": "af4744032755",
    "topic": "写五绝一首：窗外孩子练笛，想起已故的、曾与自己一同学笛的朋友。至少一处用典。",
    "poem": {
      "title": "窗笛忆同门",
      "lines": [
        "窗前童试笛",
        "向秀感音同",
        "欲举还停手",
        "同门旧曲空"
      ]
    }
  },
  {
    "id": "b3d34e8fb8f3",
    "topic": "写七绝一首：车站最后一个人工售票窗口关闭，老售票员收起用了多年的印章。",
    "poem": {
      "title": "末窗收印",
      "lines": [
        "最后人工窗落锁",
        "台前售票白头翁",
        "多年旧印收归盒",
        "站外玻璃映日红"
      ]
    }
  },
  {
    "id": "97b4a08b7913",
    "topic": "写五绝一首：借出的旧伞归还时多了一处补丁。",
    "poem": {
      "title": "还伞",
      "lines": [
        "撑开还借伞",
        "补罢线犹新",
        "旧布添深色",
        "收时识此身"
      ]
    }
  },
  {
    "id": "e8b73f650890",
    "topic": "写五绝一首：听到兄弟升迁，真心高兴，又察觉自己的嫉妒。不必道德说教。",
    "poem": {
      "title": "闻兄弟升迁席上",
      "lines": [
        "欢声共举杯，",
        "喜报为君来。",
        "旧袖拈残线，",
        "酸从指下回。"
      ]
    }
  },
  {
    "id": "ed26614edc3d",
    "topic": "写五绝一首：听到兄弟升迁，真心高兴，又察觉自己的嫉妒。不必道德说教。",
    "poem": {
      "title": "闻兄升迁",
      "lines": [
        "忽报兄高擢，",
        "由衷见至情。",
        "开颜才半拍，",
        "暗里妒芽生。"
      ]
    }
  },
  {
    "id": "3d4eeb0aef95",
    "topic": "写七绝一首：春日旧城遗址，一位农人正在播种。至少一处用典，不必写成兴亡议论。",
    "poem": {
      "title": "春日旧城遗址见农人播种",
      "lines": [
        "荒城麦陇起春风，",
        "老叟开畦语未终。",
        "旧黍离离苗未长，",
        "低头撒种任西东。"
      ]
    }
  },
  {
    "id": "d9c3075ee56a",
    "topic": "写五绝一首：窗外孩子练笛，想起已故的、曾与自己一同学笛的朋友。至少一处用典。",
    "poem": {
      "title": "闻窗外童子练笛",
      "lines": [
        "窗前初弄笛",
        "旧曲共谁寻",
        "学笛吹犹错",
        "山阳泪满襟"
      ]
    }
  },
  {
    "id": "056fdfce8d18",
    "topic": "写七绝一首：修表匠拆开已故父亲留下的旧钟，听见熟悉的零件声。至少一处用典。",
    "poem": {
      "title": "拆旧钟",
      "lines": [
        "拆散残钟零件响，",
        "瓷盘乍响渐依稀。",
        "垂眸碎响先君试，",
        "旧笛山阳叹久违。"
      ]
    }
  },
  {
    "id": "9dc9f2eea924",
    "topic": "写七绝一首：新桥通车以后，旧渡口的早食摊仍按原来的时辰生火。",
    "poem": {
      "title": "桥通后渡口早摊",
      "lines": [
        "渡口桥通车马过",
        "晨炊尚守旧时程",
        "新桥客尽阶苔冷",
        "老妇吹炉火独明"
      ]
    }
  },
  {
    "id": "6e8d408f6a0f",
    "topic": "写七绝一首：久别归乡，被儿时玩伴当作问路的游客。至少一处用典。",
    "poem": {
      "title": "归乡",
      "lines": [
        "村桥老树还相识，",
        "旧伴惊逢问客尘。",
        "笑指前村迷路处，",
        "归来已作烂柯人。"
      ]
    }
  },
  {
    "id": "cfdbe2858196",
    "topic": "写七绝一首：修表匠拆开已故父亲留下的旧钟，听见熟悉的零件声。至少一处用典。",
    "poem": {
      "title": "修表匠拆父遗旧钟",
      "lines": [
        "拆出粗叉藏匣底",
        "铿然落案旧时声",
        "山阳笛怨灯初暗",
        "入匣重安又自行"
      ]
    }
  },
  {
    "id": "aa741aa4880e",
    "topic": "写七绝一首：返乡者把墙上的红色招工告示错认成从前的春联。",
    "poem": {
      "title": "返乡误认春联",
      "lines": [
        "隔巷红疑前岁帖，",
        "风翻纸角起轻尘。",
        "来人忽住还趋步，",
        "近认招工墨尚新。"
      ]
    }
  },
  {
    "id": "0b2100809a7f",
    "topic": "写五绝一首：洪水后的村民今天缺粮，却听见来年大赈的许诺。至少一处用典。",
    "poem": {
      "title": "涸辙",
      "lines": [
        "洪涛今已退",
        "大赈许来年",
        "涸鲋求升斗",
        "西江远活泉"
      ]
    }
  },
  {
    "id": "48180129cad5",
    "topic": "写七绝一首：返乡者把墙上的红色招工告示错认成从前的春联。",
    "poem": {
      "title": "返乡误认招工告示为春联",
      "lines": [
        "倦客归村灯未上，",
        "墙头赤纸认春联。",
        "趋前始辨招工字，",
        "欲触还收手半悬。"
      ]
    }
  },
  {
    "id": "f8a9d0992969",
    "topic": "写五绝一首：借出的旧伞归还时多了一处补丁。",
    "poem": {
      "title": "还旧伞",
      "lines": [
        "还君旧伞来",
        "但说雨中回",
        "莫道磨痕在",
        "新丝短短裁"
      ]
    }
  },
  {
    "id": "2c4813752c44",
    "topic": "写七绝一首：修表匠拆开已故父亲留下的旧钟，听见熟悉的零件声。至少一处用典。",
    "poem": {
      "title": "修父遗钟",
      "lines": [
        "拆壳灯前寻隙处",
        "先君旧器手重修",
        "铜轮起落声随指",
        "独俯山阳一笛愁"
      ]
    }
  },
  {
    "id": "9ab2f3b914d3",
    "topic": "写五绝一首：洪水后的村民今天缺粮，却听见来年大赈的许诺。至少一处用典。",
    "poem": {
      "title": "洪水后问赈",
      "lines": [
        "泥墙空灶冷",
        "许赈待年来",
        "涸鲋求升斗",
        "今朝活我哉"
      ]
    }
  },
  {
    "id": "5e081e7e5269",
    "topic": "写五绝一首：听到兄弟升迁，真心高兴，又察觉自己的嫉妒。不必道德说教。",
    "poem": {
      "title": "闻弟擢迁",
      "lines": [
        "弟擢音初至，",
        "开颜拍手频。",
        "心头方一紧，",
        "紧处笑犹新。"
      ]
    }
  },
  {
    "id": "bac1b74ca295",
    "topic": "写七绝一首：车站最后一个人工售票窗口关闭，老售票员收起用了多年的印章。",
    "poem": {
      "title": "车站末窗收印",
      "lines": [
        "最后窗前人散尽",
        "人工售票闭窗时",
        "摩挲旧印初收匣",
        "掌底微温未肯离"
      ]
    }
  },
  {
    "id": "484f461f138d",
    "topic": "写五绝一首：借出的旧伞归还时多了一处补丁。",
    "poem": {
      "title": "收伞见补",
      "lines": [
        "收来新补认",
        "旧骨带秋寒",
        "客去针犹在",
        "人情报最难"
      ]
    }
  },
  {
    "id": "5639d93e76fd",
    "topic": "写五绝一首：窗外孩子练笛，想起已故的、曾与自己一同学笛的朋友。至少一处用典。",
    "poem": {
      "title": "闻笛忆亡友",
      "lines": [
        "窗前童学笛，",
        "断续不成声。",
        "共学人先逝，",
        "山阳笛里情。"
      ]
    }
  },
  {
    "id": "81459d89631e",
    "topic": "写五绝一首：祖母逐渐记不住许多事，却仍记得孙儿吃饭怕烫。",
    "poem": {
      "title": "祖母",
      "lines": [
        "孙儿何处去",
        "但记屡吹凉",
        "忘却方才问",
        "还伸手试汤"
      ]
    }
  },
  {
    "id": "38999e47bc30",
    "topic": "写五绝一首：窗外孩子练笛，想起已故的、曾与自己一同学笛的朋友。至少一处用典。",
    "poem": {
      "title": "闻窗外童笛",
      "lines": [
        "风传旧曲迟",
        "隔牖小童吹",
        "共学人何在",
        "山阳笛自悲"
      ]
    }
  },
  {
    "id": "2a43bb61403f",
    "topic": "写七绝一首：春日旧城遗址，一位农人正在播种。至少一处用典，不必写成兴亡议论。",
    "poem": {
      "title": "春日旧城遗址见农人播种",
      "lines": [
        "古垒春风枯草短",
        "农人趁晓种春畦",
        "弯腰覆土还轻拍",
        "旧陇离离黍稷齐"
      ]
    }
  },
  {
    "id": "f0bfe3a859d6",
    "topic": "写七绝一首：来访者郑重求教，却只问祈福之事，不问近在眼前的水患。至少一处用典。",
    "poem": {
      "title": "夜问",
      "lines": [
        "灯前再拜问灵祠，",
        "夜半犹前席问师。",
        "户外河声喧到枕，",
        "殷勤只问岁丰时。"
      ]
    }
  },
  {
    "id": "e1455db49b4b",
    "topic": "写七绝一首：车站最后一个人工售票窗口关闭，老售票员收起用了多年的印章。",
    "poem": {
      "title": "最后窗口",
      "lines": [
        "窗关最后客犹行",
        "误作敲窗问票声",
        "对影摇头收旧印",
        "方痕入袋伴归程"
      ]
    }
  },
  {
    "id": "fc2f14b9bd4d",
    "topic": "写五绝一首：洪水后的村民今天缺粮，却听见来年大赈的许诺。至少一处用典。",
    "poem": {
      "title": "洪水后闻赈",
      "lines": [
        "仓空余怒水",
        "断粒泣寒天",
        "大赈期来岁",
        "枯鱼待斗泉"
      ]
    }
  },
  {
    "id": "953894f07b29",
    "topic": "写五绝一首：听到兄弟升迁，真心高兴，又察觉自己的嫉妒。不必道德说教。",
    "poem": {
      "title": "闻兄迁",
      "lines": [
        "忽得兄迁信",
        "停杯复一倾",
        "欣闻犹有妒",
        "贺语隔时生"
      ]
    }
  },
  {
    "id": "e4deefd64d4f",
    "topic": "写七绝一首：返乡者把墙上的红色招工告示错认成从前的春联。",
    "poem": {
      "title": "返乡误认招工告示为春联",
      "lines": [
        "旧壁红联明夕照",
        "归来错认旧时春",
        "趋前细辨招工字",
        "认罢朱痕刺眼新"
      ]
    }
  },
  {
    "id": "eeed11d31f4d",
    "topic": "写七绝一首：修表匠拆开已故父亲留下的旧钟，听见熟悉的零件声。至少一处用典。",
    "poem": {
      "title": "拆钟",
      "lines": [
        "拆启残钟音乍起",
        "才听已识指间声",
        "空怜折戟沉沙久",
        "老轴犹随父手鸣"
      ]
    }
  },
  {
    "id": "4aa9eb6fd0cc",
    "topic": "写七绝一首：新桥通车以后，旧渡口的早食摊仍按原来的时辰生火。",
    "poem": {
      "title": "新桥通车后旧渡早食摊",
      "lines": [
        "凳脚砖支桥影乱",
        "零钱盒压塑胶平",
        "添柴火舌伸锅底",
        "滚沸声高盖笛鸣"
      ]
    }
  },
  {
    "id": "a5671a0dbe46",
    "topic": "写五绝一首：祖母逐渐记不住许多事，却仍记得孙儿吃饭怕烫。",
    "poem": {
      "title": "记烫",
      "lines": [
        "阿婆多不记",
        "尚记怕羹汤",
        "捧碗先吹冷",
        "孙儿怕烫伤"
      ]
    }
  },
  {
    "id": "652798f795e3",
    "topic": "写五绝一首：窗外孩子练笛，想起已故的、曾与自己一同学笛的朋友。至少一处用典。",
    "poem": {
      "title": "闻笛",
      "lines": [
        "窗前童弄笛",
        "旧曲尚心酸",
        "错处君频犯",
        "山阳一笛寒"
      ]
    }
  },
  {
    "id": "03c3297e172b",
    "topic": "写五绝一首：洪水后的村民今天缺粮，却听见来年大赈的许诺。至少一处用典。",
    "poem": {
      "title": "洪后退赈",
      "lines": [
        "村空锅久冷",
        "绝粒到今年",
        "许赈来年麦",
        "空怜斗水悬"
      ]
    }
  },
  {
    "id": "65445a3cf485",
    "topic": "写七绝一首：修表匠拆开已故父亲留下的旧钟，听见熟悉的零件声。至少一处用典。",
    "poem": {
      "title": "拆旧钟",
      "lines": [
        "旧匣初开尘半掩，",
        "山阳笛起为儿留。",
        "空持镊子停还住，",
        "怕拆机心泪暗收。"
      ]
    }
  },
  {
    "id": "b0bba6d6a960",
    "topic": "写七绝一首：修表匠拆开已故父亲留下的旧钟，听见熟悉的零件声。至少一处用典。",
    "poem": {
      "title": "夜拆先父旧钟",
      "lines": [
        "孤灯启匣旧钟开",
        "细响还从旧件来",
        "错认招魂归故宅",
        "重收碎件放空台"
      ]
    }
  },
  {
    "id": "4cc66232809d",
    "topic": "写七绝一首：车站最后一个人工售票窗口关闭，老售票员收起用了多年的印章。",
    "poem": {
      "title": "车站最后一个人工售票窗口关闭",
      "lines": [
        "手抚铜章温尚在，",
        "人稀队尾接空栏。",
        "关窗落板声初定，",
        "旧印收归匣底寒。"
      ]
    }
  },
  {
    "id": "7cfc5b216719",
    "topic": "写七绝一首：修表匠拆开已故父亲留下的旧钟，听见熟悉的零件声。至少一处用典。",
    "poem": {
      "title": "拆亡父旧钟闻摆轮声",
      "lines": [
        "初开旧壳有微鸣，",
        "父昔曾敲案试声。",
        "手捧轮边深锉迹，",
        "山阳笛里认平生。"
      ]
    }
  },
  {
    "id": "d883ba6aebf6",
    "topic": "写七绝一首：来访者郑重求教，却只问祈福之事，不问近在眼前的水患。至少一处用典。",
    "poem": {
      "title": "客问",
      "lines": [
        "冲泥执礼心何切",
        "却问灾祥与福缘",
        "贾傅虚蒙前席礼",
        "空阶水漫欲平川"
      ]
    }
  },
  {
    "id": "977392f977be",
    "topic": "写七绝一首：新桥通车以后，旧渡口的早食摊仍按原来的时辰生火。",
    "poem": {
      "title": "旧渡早食",
      "lines": [
        "新桥晓色动车轮",
        "旧渡炊烟未改辰",
        "老客沾泥跳板响",
        "端来不问味仍真"
      ]
    }
  },
  {
    "id": "dde4759f9bfb",
    "topic": "写五绝一首：借出的旧伞归还时多了一处补丁。",
    "poem": {
      "title": "还旧伞",
      "lines": [
        "还君旧伞迟，",
        "补处线犹垂。",
        "未敢言针拙，",
        "君先抚处知。"
      ]
    }
  },
  {
    "id": "025ed5264f39",
    "topic": "写五绝一首：洪水后的村民今天缺粮，却听见来年大赈的许诺。至少一处用典。",
    "poem": {
      "title": "闻来年大赈",
      "lines": [
        "村空水未澄",
        "冷灶断炊蒸",
        "诏许来年赈",
        "枯鱼待斗升"
      ]
    }
  },
  {
    "id": "efe8db8a9ed9",
    "topic": "写七绝一首：来访者郑重求教，却只问祈福之事，不问近在眼前的水患。至少一处用典。",
    "poem": {
      "title": "问福",
      "lines": [
        "焚香再拜祈洪福",
        "祷语周全未肯休",
        "户外波声都不问",
        "虚前席处问何求"
      ]
    }
  },
  {
    "id": "14f1cc584f94",
    "topic": "写七绝一首：春日旧城遗址，一位农人正在播种。至少一处用典，不必写成兴亡议论。",
    "poem": {
      "title": "春日旧城遗址见农人播种",
      "lines": [
        "老圃低头匀黍种",
        "残垣半掩野桃红",
        "离离旧黍谁相问",
        "笑指泥痕问碧空"
      ]
    }
  },
  {
    "id": "32f07ec37219",
    "topic": "写五绝一首：听到兄弟升迁，真心高兴，又察觉自己的嫉妒。不必道德说教。",
    "poem": {
      "title": "闻兄升迁",
      "lines": [
        "骤得兄迁信",
        "真心贺语生",
        "心头微觉涩",
        "一笑不能平"
      ]
    }
  },
  {
    "id": "7a31bc0ce4cf",
    "topic": "写七绝一首：新桥通车以后，旧渡口的早食摊仍按原来的时辰生火。",
    "poem": {
      "title": "渡头早食摊",
      "lines": [
        "车灯夜扫渡头空，",
        "老灶依时火自红。",
        "偶望新桥仍俯首，",
        "添柴细拨旧炉风。"
      ]
    }
  },
  {
    "id": "6c84ec2f2b4a",
    "topic": "写五绝一首：借出的旧伞归还时多了一处补丁。",
    "poem": {
      "title": "还伞",
      "lines": [
        "开时新色异",
        "旧伞已非初",
        "补处针痕密",
        "持来意不如"
      ]
    }
  },
  {
    "id": "4cb02387cc09",
    "topic": "写七绝一首：返乡者把墙上的红色招工告示错认成从前的春联。",
    "poem": {
      "title": "门前认红",
      "lines": [
        "旧槛新红犹旧色",
        "招工一纸贴墙头",
        "回身欲抚翘边角",
        "错认春联手未收"
      ]
    }
  },
  {
    "id": "ba0b691c3c90",
    "topic": "写七绝一首：来访者郑重求教，却只问祈福之事，不问近在眼前的水患。至少一处用典。",
    "poem": {
      "title": "水涨客问",
      "lines": [
        "闲阶水涨侵苔色",
        "束带迎宾受所求",
        "汉帝空移宣室席",
        "惟祈福祐不忧流"
      ]
    }
  },
  {
    "id": "cf1684edf12e",
    "topic": "写五绝一首：窗外孩子练笛，想起已故的、曾与自己一同学笛的朋友。至少一处用典。",
    "poem": {
      "title": "闻邻童吹笛",
      "lines": [
        "邻童笛渐清，",
        "错处认君声。",
        "此日山阳路，",
        "犹吹我独惊。"
      ]
    }
  },
  {
    "id": "2c4d97acb7a2",
    "topic": "写五绝一首：洪水后的村民今天缺粮，却听见来年大赈的许诺。至少一处用典。",
    "poem": {
      "title": "洪水后闻来年赈",
      "lines": [
        "朝来空腹立，",
        "但许次年粮。",
        "涸鲋求升斗，",
        "何如半勺汤？"
      ]
    }
  },
  {
    "id": "16079eff8a5f",
    "topic": "写七绝一首：车站最后一个人工售票窗口关闭，老售票员收起用了多年的印章。",
    "poem": {
      "title": "车站末窗收印",
      "lines": [
        "最后窗关人散尽",
        "多年旧印掌中寒",
        "从来票面留朱迹",
        "此印从今袖底安"
      ]
    }
  },
  {
    "id": "2c9b9e1f5990",
    "topic": "写七绝一首：春日旧城遗址，一位农人正在播种。至少一处用典，不必写成兴亡议论。",
    "poem": {
      "title": "春日旧城遗址见农人播种",
      "lines": [
        "旧阙春深青草没",
        "农人俯种认墒情",
        "离离彼黍初抽甲",
        "断础同泥落种声"
      ]
    }
  },
  {
    "id": "ce394802cc4f",
    "topic": "写七绝一首：来访者郑重求教，却只问祈福之事，不问近在眼前的水患。至少一处用典。",
    "poem": {
      "title": "客问",
      "lines": [
        "宾阶执简礼何虔",
        "但叩禳灾吉日篇",
        "夜半犹询宣室事",
        "涛声到座水侵筵"
      ]
    }
  },
  {
    "id": "f4fcfe722fe5",
    "topic": "写七绝一首：春日旧城遗址，一位农人正在播种。至少一处用典，不必写成兴亡议论。",
    "poem": {
      "title": "春日旧城遗址见农人播种",
      "lines": [
        "残垣草色带春风",
        "野老携囊过旧宫",
        "谓我何求春事里",
        "春深种落土膏中"
      ]
    }
  },
  {
    "id": "31be31777059",
    "topic": "写五绝一首：洪水后的村民今天缺粮，却听见来年大赈的许诺。至少一处用典。",
    "poem": {
      "title": "洪后闻赈",
      "lines": [
        "空仓对断渠，",
        "大赈许非虚。",
        "却待来年赈，",
        "谁怜涸辙鱼。"
      ]
    }
  },
  {
    "id": "5439ef723f22",
    "topic": "写五绝一首：祖母逐渐记不住许多事，却仍记得孙儿吃饭怕烫。",
    "poem": {
      "title": "试汤",
      "lines": [
        "孙来浑不识",
        "往事已难知",
        "手向汤边触",
        "还知怕烫时"
      ]
    }
  },
  {
    "id": "3143d0d16583",
    "topic": "写七绝一首：车站最后一个人工售票窗口关闭，老售票员收起用了多年的印章。",
    "poem": {
      "title": "车站最后人工售票窗口关闭",
      "lines": [
        "售票窗灯今夜暗",
        "轻摩旧印尚余温",
        "玻璃冷透无人影",
        "入屉犹扪指上痕"
      ]
    }
  },
  {
    "id": "d28f91338460",
    "topic": "写七绝一首：返乡者把墙上的红色招工告示错认成从前的春联。",
    "poem": {
      "title": "返乡错认",
      "lines": [
        "远认墙头红未改",
        "招工两字误春联",
        "趋前忽觉非春帖",
        "绛纸依然在客前"
      ]
    }
  },
  {
    "id": "4042088bb1a2",
    "topic": "写五绝一首：听到兄弟升迁，真心高兴，又察觉自己的嫉妒。不必道德说教。",
    "poem": {
      "title": "闻弟迁官",
      "lines": [
        "开樽贺得官",
        "满室顿生欢",
        "忽觉添双箸",
        "停杯味转酸"
      ]
    }
  },
  {
    "id": "498614f7cf3d",
    "topic": "写七绝一首：春日旧城遗址，一位农人正在播种。至少一处用典，不必写成兴亡议论。",
    "poem": {
      "title": "春日旧城遗址见农人播种",
      "lines": [
        "断垒泥融生草色",
        "农人撒种趁春深",
        "风回旧黍离离绿",
        "手腕斜时落籽音"
      ]
    }
  },
  {
    "id": "1124daaf2dda",
    "topic": "写七绝一首：返乡者把墙上的红色招工告示错认成从前的春联。",
    "poem": {
      "title": "归门见招工告示",
      "lines": [
        "门环欲叩手空悬",
        "赤纸招工似旧联",
        "旧岁门中今日客",
        "春风只隔一重年"
      ]
    }
  },
  {
    "id": "2a1023dbaaf5",
    "topic": "写七绝一首：春日旧城遗址，一位农人正在播种。至少一处用典，不必写成兴亡议论。",
    "poem": {
      "title": "旧城春种",
      "lines": [
        "旧堞春深农事起",
        "离离彼黍带春晖",
        "低眉点种拈残瓦",
        "碎瓦凉生指复挥"
      ]
    }
  },
  {
    "id": "b494ba298675",
    "topic": "写七绝一首：久别归乡，被儿时玩伴当作问路的游客。至少一处用典。",
    "poem": {
      "title": "归乡问路",
      "lines": [
        "归来旧巷迷南北",
        "竹马拦途问客津",
        "欲唤儿名先指路",
        "今朝已作烂柯人"
      ]
    }
  },
  {
    "id": "b27083656b2d",
    "topic": "写五绝一首：窗外孩子练笛，想起已故的、曾与自己一同学笛的朋友。至少一处用典。",
    "poem": {
      "title": "闻笛",
      "lines": [
        "闲窗闻笛弄",
        "稚子未成声",
        "故友曾同错",
        "山阳旧笛情"
      ]
    }
  },
  {
    "id": "4534e843c990",
    "topic": "写七绝一首：修表匠拆开已故父亲留下的旧钟，听见熟悉的零件声。至少一处用典。",
    "poem": {
      "title": "拆旧钟",
      "lines": [
        "启匣残钟尘未歇",
        "游丝断处旧声来",
        "沉沙洗认前朝铁",
        "父自机心拆后回"
      ]
    }
  },
  {
    "id": "d0a9db581402",
    "topic": "写五绝一首：听到兄弟升迁，真心高兴，又察觉自己的嫉妒。不必道德说教。",
    "poem": {
      "title": "闻兄弟升迁",
      "lines": [
        "信至灯明处",
        "开缄见姓名",
        "收书仍带笑",
        "抚臆暗心惊"
      ]
    }
  },
  {
    "id": "50baf7b5aa9e",
    "topic": "写五绝一首：祖母逐渐记不住许多事，却仍记得孙儿吃饭怕烫。",
    "poem": {
      "title": "记祖母",
      "lines": [
        "经年事渐荒，",
        "尚记怕羹汤。",
        "唤我名偏误，",
        "犹停手碗旁。"
      ]
    }
  },
  {
    "id": "6a70d6903d00",
    "topic": "写五绝一首：借出的旧伞归还时多了一处补丁。",
    "poem": {
      "title": "归伞",
      "lines": [
        "归时开复掩",
        "乍见补针痕",
        "线脚非原色",
        "曾遮几度昏"
      ]
    }
  },
  {
    "id": "0afb675e860c",
    "topic": "写五绝一首：祖母逐渐记不住许多事，却仍记得孙儿吃饭怕烫。",
    "poem": {
      "title": "祖母试汤",
      "lines": [
        "阿婆忆渐空",
        "老手试汤中",
        "触热微收指",
        "孙儿见指红"
      ]
    }
  },
  {
    "id": "6211bf25e9e5",
    "topic": "写七绝一首：久别归乡，被儿时玩伴当作问路的游客。至少一处用典。",
    "poem": {
      "title": "归乡问路",
      "lines": [
        "村桥旧伴遥相指",
        "口说前街旧巷名",
        "莫怪乡邻浑不辨",
        "乡音已似烂柯声"
      ]
    }
  },
  {
    "id": "95dfaee19c4c",
    "topic": "写五绝一首：借出的旧伞归还时多了一处补丁。",
    "poem": {
      "title": "还伞",
      "lines": [
        "持归犹旧物",
        "指下触新针",
        "欲问还缄口",
        "低眉意已深"
      ]
    }
  },
  {
    "id": "f86152afc1a6",
    "topic": "写七绝一首：车站最后一个人工售票窗口关闭，老售票员收起用了多年的印章。",
    "poem": {
      "title": "车站末窗",
      "lines": [
        "交班细语剪声稠，",
        "指点红泥印未休。",
        "是日关窗人散后，",
        "收将旧印一灯秋。"
      ]
    }
  },
  {
    "id": "9912e642db52",
    "topic": "写五绝一首：借出的旧伞归还时多了一处补丁。",
    "poem": {
      "title": "旧伞归还",
      "lines": [
        "相随经雨雪，",
        "借去几朝昏。",
        "补处青非旧，",
        "针痕尚带温。"
      ]
    }
  },
  {
    "id": "6931990fcfd4",
    "topic": "写七绝一首：新桥通车以后，旧渡口的早食摊仍按原来的时辰生火。",
    "poem": {
      "title": "旧渡早食摊",
      "lines": [
        "过客新桥通远岸",
        "孤棚暗火暖寒天",
        "无人过渡舟空系",
        "此火因谁照旧燃"
      ]
    }
  },
  {
    "id": "640944aecb87",
    "topic": "写五绝一首：祖母逐渐记不住许多事，却仍记得孙儿吃饭怕烫。",
    "poem": {
      "title": "碗边",
      "lines": [
        "呼孙名已忘",
        "独记碗中汤",
        "捧碗先呵气",
        "吹凉待口尝"
      ]
    }
  },
  {
    "id": "5aed7fa32b5d",
    "topic": "写七绝一首：新桥通车以后，旧渡口的早食摊仍按原来的时辰生火。",
    "poem": {
      "title": "新桥通车后过旧渡口早食摊",
      "lines": [
        "跨水新桥车去急",
        "残星未落旧津头",
        "晨炊尚照无船岸",
        "不逐车流亦未休"
      ]
    }
  },
  {
    "id": "300427f6dd5b",
    "topic": "写七绝一首：久别归乡，被儿时玩伴当作问路的游客。至少一处用典。",
    "poem": {
      "title": "归乡",
      "lines": [
        "春深鬓雪归程暮，",
        "旧友相看识面稀。",
        "自笑还乡柯烂尽，",
        "村桥却问客何归。"
      ]
    }
  },
  {
    "id": "1605150f5452",
    "topic": "写七绝一首：来访者郑重求教，却只问祈福之事，不问近在眼前的水患。至少一处用典。",
    "poem": {
      "title": "水声未答",
      "lines": [
        "斋心再拜祈多福",
        "未答先闻水拍天",
        "汉主深宵前席问",
        "愁看水势到阶前"
      ]
    }
  },
  {
    "id": "ed64fed4defc",
    "topic": "写五绝一首：祖母逐渐记不住许多事，却仍记得孙儿吃饭怕烫。",
    "poem": {
      "title": "端汤",
      "lines": [
        "端汤来唤我",
        "错唤旧时名",
        "按碗低声道",
        "先吹一口羹"
      ]
    }
  },
  {
    "id": "19e563b41190",
    "topic": "写七绝一首：返乡者把墙上的红色招工告示错认成从前的春联。",
    "poem": {
      "title": "归乡误认招工告示为春联",
      "lines": [
        "墙头一纸暗红悬",
        "近读招工墨尚鲜",
        "触纸方知浆掩字",
        "回身却认旧春联"
      ]
    }
  },
  {
    "id": "07c24e07e19e",
    "topic": "写七绝一首：来访者郑重求教，却只问祈福之事，不问近在眼前的水患。至少一处用典。",
    "poem": {
      "title": "夜半问吉",
      "lines": [
        "宾来夜半虚前席，",
        "只问蓍龟占岁宁。",
        "槛外堤根新渗水，",
        "空凭吉卜待神灵。"
      ]
    }
  },
  {
    "id": "9dabf995f1f2",
    "topic": "写七绝一首：新桥通车以后，旧渡口的早食摊仍按原来的时辰生火。",
    "poem": {
      "title": "新桥后旧渡早摊",
      "lines": [
        "旧渡星寒先引火",
        "虹桥过尽未收烟",
        "时辰不改炉先暖",
        "灶火仍红待客船"
      ]
    }
  },
  {
    "id": "ded4a03e90d0",
    "topic": "写七绝一首：返乡者把墙上的红色招工告示错认成从前的春联。",
    "poem": {
      "title": "归村误认招工告示为春联",
      "lines": [
        "归来一见误春联",
        "细看招工字色鲜",
        "半截残红犹压底",
        "摩挲旧纸立门前"
      ]
    }
  },
  {
    "id": "04cb611d5ab7",
    "topic": "写七绝一首：新桥通车以后，旧渡口的早食摊仍按原来的时辰生火。",
    "poem": {
      "title": "新桥通后旧渡早食摊",
      "lines": [
        "昨报新桥疑火歇，",
        "偏逢早市起晨烟。",
        "津头客到仍排队，",
        "扑面蒸腾似旧年。"
      ]
    }
  },
  {
    "id": "3e002373f4cb",
    "topic": "写七绝一首：久别归乡，被儿时玩伴当作问路的游客。至少一处用典。",
    "poem": {
      "title": "归乡",
      "lines": [
        "村头问路客迷津",
        "笑指槐阴旧路尘",
        "唤到唇边还忍住",
        "归来已是烂柯人"
      ]
    }
  },
  {
    "id": "9cf9726b4456",
    "topic": "写七绝一首：久别归乡，被儿时玩伴当作问路的游客。至少一处用典。",
    "poem": {
      "title": "归乡",
      "lines": [
        "乡名到口未须猜，",
        "笑问溪桥路可回。",
        "及烂柯时乡已换，",
        "君犹认作客游来。"
      ]
    }
  },
  {
    "id": "6284116d4516",
    "topic": "写七绝一首：久别归乡，被儿时玩伴当作问路的游客。至少一处用典。",
    "poem": {
      "title": "归乡",
      "lines": [
        "逢君错认寻途客",
        "笑指前村旧巷东",
        "未信棋终柯烂尽",
        "门环久抚立秋风"
      ]
    }
  },
  {
    "id": "1e55e5099512",
    "topic": "写七绝一首：车站最后一个人工售票窗口关闭，老售票员收起用了多年的印章。",
    "poem": {
      "title": "车站末个售票窗收印",
      "lines": [
        "最后人工窗已闭",
        "苍颜拭印有残红",
        "空台票尽灯初冷",
        "旧印收时压掌中"
      ]
    }
  },
  {
    "id": "2610b0aa46d7",
    "topic": "写五绝一首：听到兄弟升迁，真心高兴，又察觉自己的嫉妒。不必道德说教。",
    "poem": {
      "title": "闻兄弟升迁席上作",
      "lines": [
        "鹊噪檐前树",
        "闻君已着绯",
        "擎杯高过额",
        "落盏手先违"
      ]
    }
  },
  {
    "id": "cf0e38789b9e",
    "topic": "写七绝一首：久别归乡，被儿时玩伴当作问路的游客。至少一处用典。",
    "poem": {
      "title": "归乡被误作问路客",
      "lines": [
        "归寻巷陌迷深树",
        "旧伴翻疑问路来",
        "似烂柯人惊岁晚",
        "空看小径满苍苔"
      ]
    }
  },
  {
    "id": "fdc6b83bab7c",
    "topic": "写五绝一首：窗外孩子练笛，想起已故的、曾与自己一同学笛的朋友。至少一处用典。",
    "poem": {
      "title": "闻邻童弄笛",
      "lines": [
        "邻童初弄笛",
        "此曲记曾同",
        "指涩君先按",
        "山阳旧孔空"
      ]
    }
  },
  {
    "id": "88d2f4b823e4",
    "topic": "写五绝一首：洪水后的村民今天缺粮，却听见来年大赈的许诺。至少一处用典。",
    "poem": {
      "title": "涸辙闻赈",
      "lines": [
        "泥痕留灶侧",
        "甑釜久生尘",
        "涸辙空濡沫",
        "来年赈万人"
      ]
    }
  },
  {
    "id": "2f881eade290",
    "topic": "写五绝一首：祖母逐渐记不住许多事，却仍记得孙儿吃饭怕烫。",
    "poem": {
      "title": "晨起",
      "lines": [
        "朝来独下床",
        "忘却为谁忙",
        "饭热孙儿怕",
        "先吹一勺凉"
      ]
    }
  },
  {
    "id": "199749eb20f4",
    "topic": "写七绝一首：春日旧城遗址，一位农人正在播种。至少一处用典，不必写成兴亡议论。",
    "poem": {
      "title": "旧郭春播",
      "lines": [
        "旧郭春深犁作垄",
        "田翁只认土膏香",
        "离离黍种沿荒垒",
        "半入残垣半入行"
      ]
    }
  }
]
