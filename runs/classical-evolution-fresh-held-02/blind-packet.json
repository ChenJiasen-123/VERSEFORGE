[
  {
    "id": "bb9a11edb4b0",
    "topic": "写五绝一首：失明的母亲摸到儿子新添的一道疤，儿子只说路上滑。不必解释伤疤的真正来历。",
    "poem": {
      "title": "五绝·旧履",
      "lines": [
        "慈亲指忽扪，",
        "暗里触儿痕。",
        "只道途泥滑，",
        "重穿旧履温。"
      ]
    }
  },
  {
    "id": "65f2aa02b53d",
    "topic": "写七绝一首：女儿寄钱修屋，父亲却舍不得拆去刻着她小时候身高线的旧门。",
    "poem": {
      "title": "旧门",
      "lines": [
        "工钱远寄小山村",
        "指腹轻摩幼岁痕",
        "却把封包藏槛下",
        "朝朝侧过旧柴门"
      ]
    }
  },
  {
    "id": "d98bb95bc58f",
    "topic": "写七绝一首：雨夜整理已故朋友留下的棋子，窗外有人哼起你们从前常哼的曲调。至少一处有实际作用的用典。",
    "poem": {
      "title": "雨夜理亡友遗棋闻曲",
      "lines": [
        "灯前夜雨理遗棋",
        "指触磨痕忽住时",
        "牖外谁哼前度曲",
        "山阳笛里手还迟"
      ]
    }
  },
  {
    "id": "91b5262d24d1",
    "topic": "写七绝一首：旧宫城已辟成菜畦，农人把一块残瓦垫在播种用的桶下。至少一处用典，不必写成兴亡议论。",
    "poem": {
      "title": "菜畦断瓦",
      "lines": [
        "离离故苑作新畦，",
        "断瓦平铺桶下泥。",
        "拇指轻摩绳迹浅，",
        "无人更问黍离题。"
      ]
    }
  },
  {
    "id": "d6969d6b7ca4",
    "topic": "为旧木梳题五绝一首。诗题须标注木梳，正文不得出现木、梳二字，只能写其形、声、用、痕。",
    "poem": {
      "title": "题旧木梳",
      "lines": [
        "旧齿漏光清",
        "初穿忽有声",
        "徐分云鬓乱",
        "影里一痕轻"
      ]
    }
  },
  {
    "id": "ffc027a59a08",
    "topic": "写五绝一首：义诊棚里今天已无药，来访者却只许诺明年建成大医馆。至少一处用典。",
    "poem": {
      "title": "义诊棚",
      "lines": [
        "棚空药尽时",
        "客至只言医",
        "大馆明年建",
        "何堪斗水迟"
      ]
    }
  }
]
