[
  {
    "id": "e20f84193723",
    "topic": "写七绝一首：除夕值班时接通家里的视频，屏幕上，家人仍把一只空碗留在你的座位前。",
    "poem": {
      "title": "除夕值班视频",
      "lines": [
        "荧屏一亮夜将分，",
        "唤我留筵已可闻。",
        "碗冷空筵留箸影，",
        "屏前夹菜递殷勤。"
      ]
    }
  },
  {
    "id": "aa3dd62ae2b9",
    "topic": "写五绝一首：义诊棚里今天已无药，来访者却只许诺明年建成大医馆。至少一处用典。",
    "poem": {
      "title": "义诊棚无药",
      "lines": [
        "医棚药罄焉，",
        "我至许明年。",
        "大馆成虚诺，",
        "谁分斗水延？"
      ]
    }
  },
  {
    "id": "6df6e4f74838",
    "topic": "写五绝一首：菜农不肯卖掉小园换住华屋，雨夜却忙着接屋漏。至少一处用典，不得把这个选择写成毫无代价。",
    "poem": {
      "title": "雨夜守园",
      "lines": [
        "邻翁劝卖园，",
        "屋漏接盈盆。",
        "不换华堂住，",
        "甘同曳尾存。"
      ]
    }
  },
  {
    "id": "49d991b99f63",
    "topic": "写七绝一首：旧宫城已辟成菜畦，农人把一块残瓦垫在播种用的桶下。至少一处用典，不必写成兴亡议论。",
    "poem": {
      "title": "宫城菜畦",
      "lines": [
        "宫城旧址作蔬畦，",
        "布谷催耕雨一犁。",
        "断瓦沉沙权垫桶，",
        "弯腰认字又抛泥。"
      ]
    }
  },
  {
    "id": "d3bd102242d5",
    "topic": "写五绝一首：义诊棚里今天已无药，来访者却只许诺明年建成大医馆。至少一处用典。",
    "poem": {
      "title": "义诊棚",
      "lines": [
        "空棚药尽时，",
        "许馆筑成迟。",
        "辙鲋求升斗，",
        "空闻远水期。"
      ]
    }
  },
  {
    "id": "7b2051779e81",
    "topic": "写七绝一首：医者被郑重请进富宅，主人只问延寿的符咒，门外病人仍在等。至少一处用典。",
    "poem": {
      "title": "医者入富宅",
      "lines": [
        "朱门礼请引医途，",
        "尽退旁人乞寿符。",
        "汉帝移前亲问鬼，",
        "门前病客尚踟蹰。"
      ]
    }
  },
  {
    "id": "882139a320a5",
    "topic": "写五绝一首：学艺归乡，旧师傅的店已换过几轮招牌，问遍附近的人也无人知道他的名字。至少一处用典。",
    "poem": {
      "title": "归寻旧师",
      "lines": [
        "归闻旧市声，",
        "学罢烂柯惊。",
        "旧肆牌频换，",
        "无人识姓名。"
      ]
    }
  },
  {
    "id": "e2b4f969d85a",
    "topic": "写七绝一首：小镇照相馆今天关门，摄影师给最后一位客人拍证件照，仍伸手扶正他的衣领。",
    "poem": {
      "title": "小镇照相馆关门日",
      "lines": [
        "蓝帷半落有余温，",
        "独客灯前坐不言。",
        "镜外还来扶正领，",
        "方留证照掩重门。"
      ]
    }
  },
  {
    "id": "d1833ca153d1",
    "topic": "写七绝一首：旧宫城已辟成菜畦，农人把一块残瓦垫在播种用的桶下。至少一处用典，不必写成兴亡议论。",
    "poem": {
      "title": "旧宫城菜畦",
      "lines": [
        "宫城废苑作春畦，",
        "断瓦磨泥认旧题。",
        "细拭苔痕文渐出，",
        "移来垫桶种行齐。"
      ]
    }
  },
  {
    "id": "2d86c8c3e828",
    "topic": "写五绝一首：菜农不肯卖掉小园换住华屋，雨夜却忙着接屋漏。至少一处用典，不得把这个选择写成毫无代价。",
    "poem": {
      "title": "守园夜漏",
      "lines": [
        "穿茅漏似绳，",
        "不卖小园藤。",
        "涸鲋辞高厦，",
        "持盆接斗升。"
      ]
    }
  },
  {
    "id": "d9e59cb89c16",
    "topic": "写七绝一首：小镇照相馆今天关门，摄影师给最后一位客人拍证件照，仍伸手扶正他的衣领。",
    "poem": {
      "title": "小镇照相馆关门日",
      "lines": [
        "招牌摘下字犹新",
        "独客端然待写真",
        "袖底仍扶衣领正",
        "抽身取景镜中人"
      ]
    }
  },
  {
    "id": "df3d3ac33937",
    "topic": "为旧木梳题五绝一首。诗题须标注木梳，正文不得出现木、梳二字，只能写其形、声、用、痕。",
    "poem": {
      "title": "旧木梳",
      "lines": [
        "微弯齿欲倾",
        "入匣一声清",
        "瘦鬓曾轻理",
        "痕深背自明"
      ]
    }
  },
  {
    "id": "fd57e4a31177",
    "topic": "写五绝一首：失明的母亲摸到儿子新添的一道疤，儿子只说路上滑。不必解释伤疤的真正来历。",
    "poem": {
      "title": "归",
      "lines": [
        "归来袖尚凉",
        "暗里触新伤",
        "但答泥途滑",
        "无言握更长"
      ]
    }
  },
  {
    "id": "2e94924ce7bc",
    "topic": "写七绝一首：女儿寄钱修屋，父亲却舍不得拆去刻着她小时候身高线的旧门。",
    "poem": {
      "title": "旧门",
      "lines": [
        "钱来不换旧家门",
        "卸下门扉护旧痕",
        "漆就新门存旧板",
        "灯昏暗里摸余温"
      ]
    }
  },
  {
    "id": "9c880b67b398",
    "topic": "写七绝一首：女儿寄钱修屋，父亲却舍不得拆去刻着她小时候身高线的旧门。",
    "poem": {
      "title": "留门",
      "lines": [
        "灯前指爪认残痕，",
        "瓦片堆阶欲换门。",
        "尚记扶墙初过膝，",
        "留门不拆待归村。"
      ]
    }
  },
  {
    "id": "a7aa4e9a7d95",
    "topic": "写七绝一首：雨夜整理已故朋友留下的棋子，窗外有人哼起你们从前常哼的曲调。至少一处有实际作用的用典。",
    "poem": {
      "title": "雨夜理亡友遗棋闻隔牖旧曲",
      "lines": [
        "灯昏雨细理遗棋",
        "拾子枰边手渐迟",
        "隔牖人低吟旧曲",
        "山阳笛起泪先垂"
      ]
    }
  },
  {
    "id": "7072ddfd1c8b",
    "topic": "写五绝一首：失明的母亲摸到儿子新添的一道疤，儿子只说路上滑。不必解释伤疤的真正来历。",
    "poem": {
      "title": "摩瘢",
      "lines": [
        "瞽母触新瘢，",
        "儿言路滑难。",
        "闻声犹按处，",
        "指下久盘桓。"
      ]
    }
  },
  {
    "id": "5575e1d45914",
    "topic": "写五绝一首：第一次领薪后买了一双新鞋，走到雨里却舍不得落脚。不必写成苦难叙事。",
    "poem": {
      "title": "初俸买鞋遇雨",
      "lines": [
        "得俸买新鞋",
        "开门雨满阶",
        "提鞋光脚走",
        "笑踏软泥街"
      ]
    }
  },
  {
    "id": "d5dd79f4c2ea",
    "topic": "写五绝一首：学艺归乡，旧师傅的店已换过几轮招牌，问遍附近的人也无人知道他的名字。至少一处用典。",
    "poem": {
      "title": "归寻旧师",
      "lines": [
        "归乡似烂柯，",
        "旧肆换牌多。",
        "遍问无人识，",
        "名微艺未磨。"
      ]
    }
  },
  {
    "id": "aef626243908",
    "topic": "写七绝一首：除夕值班时接通家里的视频，屏幕上，家人仍把一只空碗留在你的座位前。",
    "poem": {
      "title": "除夕值班接家视频",
      "lines": [
        "钟声隔巷未还家，",
        "指下屏开接烛花。",
        "旧座杯盘空碗待，",
        "临屏也举手中茶。"
      ]
    }
  },
  {
    "id": "b899fc30fd34",
    "topic": "写五绝一首：第一次领薪后买了一双新鞋，走到雨里却舍不得落脚。不必写成苦难叙事。",
    "poem": {
      "title": "初薪买鞋",
      "lines": [
        "初薪买得鞋",
        "赤足踏长街",
        "怕湿提新履",
        "归来上雨阶"
      ]
    }
  },
  {
    "id": "69bd9206a1c5",
    "topic": "为旧木梳题五绝一首。诗题须标注木梳，正文不得出现木、梳二字，只能写其形、声、用、痕。",
    "poem": {
      "title": "题旧木梳",
      "lines": [
        "弯弧入掌微",
        "旧齿涩声稀",
        "汝试分云乱",
        "新痕掩旧辉"
      ]
    }
  },
  {
    "id": "0a728c56a273",
    "topic": "写七绝一首：雨夜整理已故朋友留下的棋子，窗外有人哼起你们从前常哼的曲调。至少一处有实际作用的用典。",
    "poem": {
      "title": "雨夜理亡友遗棋闻邻人微吟",
      "lines": [
        "灯昏雨暗理君棋，",
        "按谱才安又敛时。",
        "隔牖微吟停一拍，",
        "山阳旧曲待君随。"
      ]
    }
  },
  {
    "id": "ce3521e7c99a",
    "topic": "写七绝一首：医者被郑重请进富宅，主人只问延寿的符咒，门外病人仍在等。至少一处用典。",
    "poem": {
      "title": "延医",
      "lines": [
        "朱门礼客意偏浓，",
        "只乞灵符驻岁容。",
        "汉主殷勤宣室问，",
        "门前病者正扪胸。"
      ]
    }
  }
]
