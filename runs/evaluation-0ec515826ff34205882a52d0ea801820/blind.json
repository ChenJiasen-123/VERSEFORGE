  {
    "pair": 3,
    "task": {
      "topic": "发现日常中的可笑之处",
      "genre": "modern",
      "max_lines": 12,
      "required_words": [],
      "forbidden_words": [],
      "extra_requirements": "轻快或幽默；不把他人的困境当笑料。"
    },
    "samples": [
      {
        "sample_id": "7d406f5f8f6e",
        "poem": {
          "title": "日常小故障观察员",
          "lines": [
            "雨停后我撑开伞，",
            "把它撑成一朵倒着开的花。",
            "公交车在站牌前打了个嗝，",
            "下来三个人，又吞回两个。",
            "冰箱门一开就认真审问我：",
            "“你确定那盒酸奶不是房客？”",
            "我点头，灯灭了，",
            "像它憋不住笑，赶紧关上门。",
            "电梯里的镜子总比我早到，",
            "先替我把领口扶正，",
            "再提醒我：别对楼层按钮",
            "许愿，它只负责上下。"
          ]
        }
      },
      {
        "sample_id": "d7d81e4e1a0b",
        "poem": {
          "title": "日常漏气指南",
          "lines": [
            "闹钟响到第三遍，才承认",
            "昨夜立的志是纸糊的",
            "牙膏从中间挤，像给清晨",
            "开一道不守规矩的小门",
            "电梯门合上前，我向镜面",
            "练习一个不像领导的微笑",
            "保温杯里泡着枸杞，也泡着",
            "下午三点突然想离职的泡泡",
            "雨伞在门口晾成一朵",
            "翻面的蘑菇，滴水很认真",
            "我把待办清单折成纸船",
            "放进洗碗池，看它绕圈沉没"
          ]
        }
      }
    ],
