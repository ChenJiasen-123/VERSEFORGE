[
  {
    "pair": 1,
    "task": {
      "topic": "换班后的清晨",
      "genre": "modern",
      "max_lines": 12,
      "required_words": [
        "灯"
      ],
      "forbidden_words": [],
      "extra_requirements": "现代诗；允许明亮与疲惫并存，不虚构具体工厂史。"
    },
    "samples": [
      {
        "sample_id": "7833bce808c5",
        "poem": {
          "title": "换班后的清晨",
          "lines": [
            "鞋底还沾着夜班的暖气，",
            "推门时撞碎一层薄霜。",
            "行道树把影子铺成铁轨，",
            "有人在上面走，有人被送回来。",
            "早餐摊的蒸汽弯下腰，",
            "替我们擦掉袖口上的时辰。",
            "一盏灯还挂在仓库檐下，",
            "像没咽下去的一句话。",
            "白昼从楼缝间淌过来，",
            "缓慢地，漫过发涩的眼皮。",
            "我数着脚步，数到第二十下，",
            "那盏灯终于在身后熄了。"
          ]
        }
      },
      {
        "sample_id": "cb687b01b0eb",
        "poem": {
          "title": "换班后的清晨",
          "lines": [
            "帽檐还压着夜班的铁屑味，",
            "工牌在胸前慢慢降温。",
            "厂门把这群人交还给街，",
            "路沿的早餐摊刚揭开白汽。",
            "有人靠着站牌闭了一会儿眼，",
            "手里塑料袋随着呼吸轻响。",
            "阳光贴上来，像替我数",
            "还有多少级台阶没走完。",
            "远处那盏路灯还没熄，",
            "像谁忘了咽下的一粒安定，",
            "在发白的天空下面，",
            "继续替我值完最后半班。"
          ]
        }
      }
    ],
    "judgment": {
