  {
    "pair": 4,
    "task": {
      "topic": "邀请陌生人一起看江",
      "genre": "modern",
      "max_lines": 12,
      "required_words": [],
      "forbidden_words": [],
      "extra_requirements": "写现代诗；包含明确邀请，不虚构真实景点掌故。"
    },
    "samples": [
      {
        "sample_id": "9961f7bc11f1",
        "poem": {
          "title": "江边邀请",
          "lines": [
            "傍晚六点，水把天空揉成灰蓝",
            "桥墩下浮着一只空矿泉水瓶",
            "驳船的灯还没亮，汽笛先低低试了一声",
            "我在石阶第三级坐下，旁边空着一半",
            "你如果正从堤上经过，不必认识我",
            "要不要停一会儿，和我一起看江",
            "看浪把碎光推近，又收回去",
            "看对岸的烟囱把白气吐进云里",
            "我带了两个橘子，一个给你",
            "我们不交换姓名，只交换水流的方向",
            "等夜色漫过脚背，你走你的，我留我的",
            "江还在往前，像刚学会沉默的陌生人"
          ]
        }
      },
      {
        "sample_id": "a4da43ba7ecc",
        "poem": {
          "title": "沿江的邀请",
          "lines": [
            "天色把最后一班公交送过桥",
            "我站在护栏边，手里两杯热豆浆",
            "风从水面翻上来，带着湿泥和柴油味",
            "你如果正好也没地方去",
            "就过来站一会儿吧",
            "看货船把灯影拖成一条抖动的线",
            "看对岸的窗子一盏一盏亮起来",
            "我们不交换姓名",
            "只交换哪片云走得慢",
            "江面会替我们收好没说出口的话",
            "等夜完全落下来",
            "你再决定往哪边走"
          ]
        }
      }
    ],
