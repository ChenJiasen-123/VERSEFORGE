  {
    "pair": 2,
    "task": {
      "topic": "一次没有解决的告别",
      "genre": "modern",
      "max_lines": 12,
      "required_words": [],
      "forbidden_words": [],
      "extra_requirements": "可直接抒情，不强制反转或具体物件结尾。"
    },
    "samples": [
      {
        "sample_id": "9c25519f98b6",
        "poem": {
          "title": "检票口",
          "lines": [
            "你把伞收拢，水顺着伞骨",
            "滴在我鞋尖，又渗进地砖缝",
            "候车厅的灯坏了半排",
            "剩下的光落在你背包的拉链上",
            "广播念着别处的站名",
            "我听见你喉咙里也有一次播报",
            "却没有说出目的地",
            "你转身时，背包带滑下肩",
            "我抬手，最终只替自己",
            "拉正了衣领",
            "那趟车开走后，检票口一直空着",
            "像一句没能递出去的话"
          ]
        }
      },
      {
        "sample_id": "b321c623a5c0",
        "poem": {
          "title": "一次没有解决的告别",
          "lines": [
            "门合上时，锁舌只转了一半",
            "楼道灯亮到二楼就灭了",
            "伞还在你门边滴水，虽然雨早停",
            "杯底那圈茶渍慢慢干成地图",
            "我们坐着，等一句合适的话",
            "车站广播又念到别处",
            "你抬手，像要碰我的袖口",
            "最后只理了理自己的围巾",
            "这些年我经过很多站台",
            "听见水龙头没拧紧的夜晚",
            "一滴，一滴，替谁数着",
            "我知道有些告别不靠关门完成"
          ]
        }
      }
    ],
