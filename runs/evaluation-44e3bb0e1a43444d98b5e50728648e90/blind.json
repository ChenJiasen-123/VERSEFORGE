    "task": {
      "topic": "一次没有解决的告别",
      "genre": "modern",
      "max_lines": 12,
      "required_words": [],
      "forbidden_words": [],
      "extra_requirements": "可直接抒情，不强制反转或具体物件结尾。",
      "qijue_pattern": null
    },
    "samples": [
      {
        "sample_id": "14ae01bc7e22",
        "poem": {
          "title": "未完成的告别",
          "lines": [
            "你在玄关弯腰系鞋带，",
            "鞋尖对着门，又转回屋里。",
            "我把想说的一半咽下，",
            "另一半在杯沿留下白印。",
            "电梯下到一楼又升上来，",
            "像一句反复删改的句子。",
            "后来我把窗开到最大，",
            "风把桌布吹成你的侧影，",
            "又很快放平。",
            "夜里我听见楼道有人咳嗽，",
            "不是你，可我还是把门开了一条缝，",
            "站了很久才关。"
          ]
        }
      },
      {
        "sample_id": "9477936a4dab",
        "poem": {
          "title": "半句话",
          "lines": [
            "站台的灯比平日亮得早",
            "你的名字停在我喉咙口",
            "像一粒卡在锁孔里的沙",
            "列车进站，风把你的围巾掀向另一边",
            "我数着你行李箱的轮子",
            "数到它不再响",
            "那半句话我终究没说",
            "折了两折，塞进外套内袋",
            "洗衣时它湿过，没有化开",
            "在阳台上晾了一个下午",
            "如今每次穿那件外套",
            "胸口就有一小片硬的、凉的地方"
          ]
        }
      }
    ],
