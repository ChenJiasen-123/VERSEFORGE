    "task": {
      "topic": "邀请陌生人一起看江",
      "genre": "modern",
      "max_lines": 12,
      "required_words": [],
      "forbidden_words": [],
      "extra_requirements": "写现代诗；包含明确邀请，不虚构真实景点掌故。",
      "qijue_pattern": null
    },
    "samples": [
      {
        "sample_id": "b3a6e3be0539",
        "poem": {
          "title": "江边的空椅子",
          "lines": [
            "下午四点，江水把光磨成碎铜，",
            "桥墩的影子斜进浅滩。",
            "你如果刚好路过，",
            "请把耳机摘下一只，",
            "坐在我左边那把空椅上——",
            "我们不必交换姓名，",
            "只看货船低低地压过水面，",
            "看一只白鹭把脚收回翅下。",
            "潮气会爬上裤脚，",
            "风会把对岸的芦苇吹弯；",
            "等汽笛响过第三声，",
            "你再决定要不要留下。"
          ]
        }
      },
      {
        "sample_id": "ddec823e91b1",
        "poem": {
          "title": "黄昏，问一个陌生人",
          "lines": [
            "天色把石阶照得发白，",
            "你站在堤上，手插在口袋里。",
            "我想问你，能否一起走一段江岸——",
            "不必说话，只听听水擦过石头的声音。",
            "货船从桥下压低嗓子驶过，",
            "对岸的灯一盏接一盏亮起来。",
            "我们可以各看各的，",
            "你把没说完的事留在岸上，",
            "我把手从袖口里伸出来指向水面：",
            "那儿，刚有一条鱼翻了个身。",
            "如果你愿意，就跟着我往下游走，",
            "不愿意也没关系，江一直在这里。"
          ]
        }
      }
    ],
