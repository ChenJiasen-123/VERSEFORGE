      "genre": "modern",
      "max_lines": 12,
      "required_words": [],
      "forbidden_words": [],
      "extra_requirements": "轻快或幽默；不把他人的困境当笑料。",
      "qijue_pattern": null
    },
    "samples": [
      {
        "sample_id": "021d3d125bf3",
        "poem": {
          "title": "日常纠错本",
          "lines": [
            "早晨，牙刷在杯里练习倒立，",
            "牙膏把最后一点脾气挤到我手上。",
            "电梯门合上又张开，",
            "替我复习一句没说出口的“稍等”。",
            "地铁报站把站名念得飞快，",
            "玻璃里那张脸还没睡醒，先学会了点头。",
            "午饭时，一粒米从筷子间逃走，",
            "落在会议通知上，像临时增加的议程。",
            "晚上，路由器眨着蓝灯，",
            "我把白天掉的扣子放回抽屉，",
            "洗衣机替所有口袋翻滚着辩解：",
            "“不是丢了，是换了个地方待着。”"
          ]
        }
      },
      {
        "sample_id": "5c8545dff2ef",
        "poem": {
          "title": "日常岔子观察",
          "lines": [
            "闹钟响到第三遍",
            "才承认自己不是被窝的对手",
            "冰箱门开成会议室",
            "半盒牛奶在冷光里举手",
            "袜子从洗衣机越狱",
            "在沙发底下和灰尘开会",
            "电梯每层都停",
            "像替我练习点头",
            "雨伞晴天躺在包底",
            "雨天却忘在门后",
            "我把遥控器当手机",
            "对电视喊了一声“喂”"
          ]
        }
      }
    ],
