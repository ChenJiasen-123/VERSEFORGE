    "poem": {
      "title": "夜班散后待包",
      "lines": [
        "夜作收时街尚黑",
        "霜风未歇待清晨",
        "长街月落犹余影",
        "小店灯明已候人",
        "白汽初腾笼未熟",
        "寒风渐紧客来频",
        "蒸开第一笼中雪",
        "暖透工衣倦眼新"
      ]
    },
