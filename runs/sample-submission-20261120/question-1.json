  "brief": {
    "genre": "qijue",
    "topic": "为一件日常器物题绝句：诗题标注器物，诗中隐去其名，只写形、声、用、痕。",
    "max_lines": 4,
    "requirements": [
      "五绝或七绝一首，本题选七绝",
      "诗题中必须标注所题器物",
      "诗中不得出现该器物的名称",
      "诗中只能写该器物的形、声、用、痕"
    ],
    "examples": [],
    "required_words": [],
    "forbidden_words": [],
    "directions": [
      "方向一：以清晨厨房中家人递来热水、杯壁留下手痕为核心动作，发话者为接过器物的人，诗题直标器物，正文只写圆腹、注水声与经年磕痕。",
      "方向二：把时间次序倒置，先写夜里静置在桌角、盛着半盏残茶的器物，再回写到白日里来客围坐、屡次斟饮的声响与缺口，关系是旧客与主人之间不点破的疏远。",
      "方向三：发话者改为器物旁一把小凳上的孩子，看大人弯腰取放、听其落地一响，全诗只呈现仰视所见的弧度、碰撞声与门边磨损，不写大人正面。"
    ],
    "selected_direction": 0,
    "pattern": "ping_rhyme",
    "unsupported_reason": ""
  },
